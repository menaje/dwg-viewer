{
  "name": "dwg-viewer-vscode",
  "displayName": "DWG Viewer",
  "description": "Open-source, local-first DWG viewing with Korean CAD fonts, XREFs, measurements, text search, layouts, and PNG/PDF export",
  "version": "0.1.1",
  "publisher": "menaje",
  "license": "MPL-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/menaje/dwg-viewer.git",
    "directory": "apps/vscode-extension"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "dwg",
    "cad",
    "viewer",
    "libredwg",
    "shx",
    "bigfont",
    "xref",
    "measurement"
  ],
  "main": "./dist/src/extension.js",
  "activationEvents": [
    "onCustomEditor:dwgViewer.dwg",
    "onCommand:dwgViewer.addShxFontFolders",
    "onCommand:dwgViewer.selectLibreDwgAdapter",
    "onCommand:dwgViewer.diagnoseLibreDwgAdapter",
    "onCommand:dwgViewer.searchWorkspaceText",
    "onCommand:dwgViewer.toggleTextSearchRegularExpression",
    "onView:dwgViewer.textSearch"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dwgViewer.addShxFontFolders",
        "title": "DWG Viewer: SHX 글꼴 폴더 추가"
      },
      {
        "command": "dwgViewer.selectLibreDwgAdapter",
        "title": "DWG Viewer: LibreDWG 변환기 선택"
      },
      {
        "command": "dwgViewer.diagnoseLibreDwgAdapter",
        "title": "DWG Viewer: LibreDWG 변환기 진단"
      },
      {
        "command": "dwgViewer.searchWorkspaceText",
        "title": "DWG Viewer: 워크스페이스 도면 문자 검색",
        "icon": "$(search)"
      },
      {
        "command": "dwgViewer.refreshWorkspaceTextSearch",
        "title": "DWG Viewer: 도면 문자 검색 다시 실행",
        "icon": "$(refresh)"
      },
      {
        "command": "dwgViewer.toggleTextSearchRegularExpression",
        "title": "DWG Viewer: 도면 문자 검색 정규식 사용",
        "icon": "$(regex)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "dwgViewer.textSearch",
          "name": "DWG 문자 검색",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dwgViewer.searchWorkspaceText",
          "when": "view == dwgViewer.textSearch",
          "group": "navigation@1"
        },
        {
          "command": "dwgViewer.refreshWorkspaceTextSearch",
          "when": "view == dwgViewer.textSearch",
          "group": "navigation@2"
        },
        {
          "command": "dwgViewer.toggleTextSearchRegularExpression",
          "when": "view == dwgViewer.textSearch",
          "group": "navigation@3",
          "toggled": "dwgViewer.textSearchRegularExpressionEnabled"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "dwgViewer.dwg",
        "displayName": "DWG Viewer",
        "selector": [
          {
            "filenamePattern": "*.dwg"
          },
          {
            "filenamePattern": "*.DWG"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "DWG Viewer",
      "properties": {
        "dwgViewer.libredwgAdapterPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the separately installed GPL LibreDWG adapter executable."
        },
        "dwgViewer.progressivePreview": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Show an overview while full conversion continues. This improves first-frame latency but substantially increases concurrent memory."
        },
        "dwgViewer.shxFontDirectories": {
          "type": "array",
          "default": [],
          "scope": "machine",
          "items": {
            "type": "string"
          },
          "maxItems": 31,
          "uniqueItems": true,
          "description": "Absolute folders searched non-recursively for SHX and BigFont files after the first drawing frame."
        },
        "dwgViewer.shxFontMappings": {
          "type": "object",
          "default": {},
          "scope": "machine",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Map a DWG-requested SHX name to a replacement filename in the configured folders or to an absolute SHX file path."
        },
        "dwgViewer.shxBigFontEncodings": {
          "type": "object",
          "default": {},
          "scope": "window",
          "maxProperties": 128,
          "additionalProperties": {
            "type": "string",
            "enum": [
              "auto",
              "euc-kr",
              "cp949",
              "johab"
            ]
          },
          "description": "Map a DWG-requested BigFont name to auto glyph probing, strict EUC-KR, Windows CP949/UHC, or Johab CP1361 codes."
        },
        "dwgViewer.xrefSearchDirectories": {
          "type": "array",
          "default": [],
          "scope": "machine",
          "items": {
            "type": "string"
          },
          "maxItems": 31,
          "uniqueItems": true,
          "description": "Absolute folders searched recursively and within fixed limits when a DWG external reference is not found at its stored path."
        },
        "dwgViewer.imageSearchDirectories": {
          "type": "array",
          "default": [],
          "scope": "machine",
          "items": {
            "type": "string"
          },
          "maxItems": 31,
          "uniqueItems": true,
          "description": "Absolute folders searched recursively and within fixed limits when a JPG or PNG drawing image is not found at its stored path."
        },
        "dwgViewer.textSearchMaximumFiles": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 500,
          "scope": "window",
          "description": "Maximum number of workspace DWG files inspected by one text search."
        },
        "dwgViewer.textSearchMaximumResults": {
          "type": "integer",
          "default": 2000,
          "minimum": 1,
          "maximum": 10000,
          "scope": "window",
          "description": "Maximum number of DWG text search results retained in the Explorer view."
        },
        "dwgViewer.textSearchMatchCase": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Match letter case in workspace DWG text search."
        },
        "dwgViewer.textSearchWholeWord": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Match whole words only in workspace DWG text search."
        },
        "dwgViewer.textSearchUseRegularExpression": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Use a bounded JavaScript regular expression by default in workspace DWG text search. The Explorer view toggle is retained per workspace."
        }
      }
    }
  },
  "scripts": {
    "build:webview": "node scripts/build-webview.mjs",
    "prepare:package": "node scripts/prepare-package.mjs",
    "compile": "tsc -p tsconfig.json",
    "build": "pnpm run build:webview && pnpm run compile && pnpm run prepare:package",
    "test:qualification": "node --test scripts/*.test.mjs",
    "qualify:host": "node scripts/qualify-extension-host.mjs",
    "test": "pnpm run compile && node --test dist/test/*.test.js && pnpm run test:qualification",
    "check": "pnpm run build && node --test dist/test/*.test.js && pnpm run test:qualification",
    "package:vsix": "pnpm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  }
}
