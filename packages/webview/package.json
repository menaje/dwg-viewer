{
  "name": "@menaje/viewer-webgl",
  "version": "0.1.1",
  "description": "Embeddable WebGL2 presentation for Viewer Core with DWG Scene Cache support",
  "license": "MPL-2.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./src/public-api.mjs",
    "./dwg": "./src/dwg-presentation.mjs",
    "./renderer": "./src/renderer.mjs",
    "./render-delta": "./src/render-delta-adapter.mjs"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/menaje/dwg-viewer.git",
    "directory": "packages/webview"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "imports": {
    "#shx-parser": "@mlightcad/shx-parser/dist/index.es.js"
  },
  "scripts": {
    "check": "node --check src/*.mjs && node --test test/*.test.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@menaje/dwg-scene-source": "0.1.1",
    "@menaje/viewer-render-protocol": "0.1.2",
    "@menaje/viewer-core": "0.1.2",
    "@menaje/viewer-ui": "0.1.2",
    "@mlightcad/shx-parser": "1.4.5",
    "earcut": "3.2.3"
  }
}
